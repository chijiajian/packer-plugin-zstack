# Copy to .env, chmod 600 .env. Do not commit .env.
# Packer does not load dotenv files automatically: set -a; source .env; set +a
ZSTACK_HOST=
ZSTACK_PORT=8080
ZSTACK_ACCESS_KEY_ID=
ZSTACK_ACCESS_KEY_SECRET=
# Alternatively use account authentication, leaving both access key values empty:
# ZSTACK_ACCOUNT_NAME=
# ZSTACK_ACCOUNT_PASSWORD=

# Optional cloud acceptance (explicitly opt in; creates/deletes test resources):
# ZSTACK_ACC=1
# Optional architecture (default for URL input: x86_64):
# ZSTACK_ACC_ARCHITECTURE=aarch64
# Choose exactly one source:
# ZSTACK_ACC_IMAGE_UUID=
# ZSTACK_ACC_IMAGE_URL=
# Choose NETWORK_UUID or a comma-separated NETWORK_UUIDS list, not both.
# ZSTACK_ACC_NETWORK_UUID=
# ZSTACK_ACC_NETWORK_UUIDS=
# ZSTACK_ACC_DEFAULT_NETWORK_UUID=
# ZSTACK_ACC_ZONE_UUID=
# ZSTACK_ACC_CLUSTER_UUID=
# ZSTACK_ACC_HOST_UUID=
# ZSTACK_ACC_CHECK_EXPORT=1
# ZSTACK_ACC_BACKUP_STORAGE_UUID=
# ZSTACK_ACC_COMMUNICATOR=ssh
# ZSTACK_ACC_SSH_USERNAME=
# ZSTACK_ACC_SSH_PASSWORD=
# ZSTACK_ACC_SCENARIO=key-cleanup
# Optional Linux cloud-init payload (plaintext, use your environment loader for newlines):
# ZSTACK_ACC_USER_DATA=
# Optional SSH bastion:
# ZSTACK_ACC_SSH_BASTION_HOST=
# ZSTACK_ACC_SSH_BASTION_USERNAME=
# ZSTACK_ACC_SSH_BASTION_PASSWORD=
# Windows acceptance (configure HTTPS WinRM in the disposable source image first):
# ZSTACK_ACC_COMMUNICATOR=winrm
# ZSTACK_ACC_PLATFORM=WindowsVirtio
# ZSTACK_ACC_ARCHITECTURE=x86_64
# ZSTACK_ACC_CPU_NUM=2
# ZSTACK_ACC_MEMORY_SIZE=4096
# ZSTACK_ACC_WINRM_USERNAME=Administrator
# ZSTACK_ACC_WINRM_PASSWORD=
# ZSTACK_ACC_WINRM_USE_SSL=1
# ZSTACK_ACC_WINRM_INSECURE=1

# Opt-in ISO installation acceptance; private JSON config may contain credentials.
ZSTACK_ACC_ISO=0
ZSTACK_ACC_ISO_CONFIG_FILE=
